# Create a Supabase project, apply supabase/migrations/001_initial_schema.sql,
# then set these values in your local environment / deployment secrets.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Never put a service_role key or other secret in a VITE_ variable.